# Trading Mode Configuration
# PAPER_TRADING=true means simulated trades (NO REAL MONEY)
# PAPER_TRADING=false means real trades (REAL MONEY)
PAPER_TRADING=true

# Binance API Credentials
# For paper trading, you can use read-only API keys or leave empty
# For real trading, you MUST use valid API keys with trading permissions
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# News API (Optional - for sentiment analysis)
NEWS_API_KEY=your_news_api_key_here

# Trading Parameters
INITIAL_CAPITAL=10000.0
MIN_SCORE_THRESHOLD=60
RISK_PER_TRADE_MIN=0.10
RISK_PER_TRADE_MAX=0.25

# Database
DATABASE_PATH=trading_bot.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
